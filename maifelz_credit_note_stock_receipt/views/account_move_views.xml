<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_maifelz_credit_note_stock" model="ir.ui.view">
        <field name="name">account.move.form.inherit.maifelz.credit.note.stock</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_picking" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-truck"
                        invisible="picking_count == 0 or move_type != 'out_refund'">
                    <field name="picking_count" widget="statinfo" string="Receipts"/>
                </button>
            </div>
            <xpath expr="//field[@name='invoice_date']" position="after">
                 <field name="warehouse_id" 
                        string="Return Warehouse" 
                        invisible="move_type != 'out_refund'" 
                        required="move_type == 'out_refund'"/>
            </xpath>
        </field>
    </record>
</odoo>
